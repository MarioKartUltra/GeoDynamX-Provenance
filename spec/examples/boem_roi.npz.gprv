{"gprv":"0.1","processStep":[{"description":"Reported: seafloor horizon picked on 200+ surveys; where surveys overlap, the best resolution kept, leaving 117. Confidential data.","id":"p1","output":[{"id":"r1"}],"source":["s1"]},{"description":"Reported: resampled to 40 x 40 ft cells, north-south, NAD27; small gaps filled by convergent gridding.","id":"p2","output":[{"id":"r2"}],"source":["r1"]},{"description":"Reported: seams shifted by hand, +/-10-20 ms two-way time (seasonal Loop Current velocities). Manual.","id":"p3","output":[{"id":"r3"}],"source":["r2"]},{"description":"Reported: two-way time in ms x 0.0005 to one-way seconds, then the 7th-order time-to-depth polynomial; depth in ft.","id":"p4","output":[{"id":"r4"}],"reference":[{"title":"Advocate and Hood 1993, Geo-Marine Letters 13, 207-211"}],"source":["r3"]},{"description":"Reported: remaining gaps spliced in from 3D depth surveys.","id":"p5","output":[{"id":"r5"}],"report":[{"description":"Checked against 300 wells: mean error 1.3 % of water depth (product page).","name":"outcome"}],"source":["r4"]},{"description":"Reported: exported from ArcMap as GeoTIFF; downloaded from the BOEM product page.","id":"p6","output":[{"id":"r6","sourceCitation":{"sha256":"3e7450dea4f9329b0725aef7c25cddbac0906e0a2ad70351630ddb82a3b28b79","title":"BOEMbathyW_ft.tif"}}],"source":["r5"]},{"description":"ROI window, 4096x4096 from (20000, 12000).","id":"p7","output":[{"id":"d1"}],"processingInformation":{"identifier":{"code":"roi/window","codeSpace":"geodynamix"},"runTimeParameters":{"height":4096,"width":4096,"x0":20000,"y0":12000},"softwareReference":{"edition":"6194b86e5859cf5a4a0d68f8425b8ac8d86d2df8","id":"gdx","onlineResource":[{"linkage":"https://github.com/MarioKartUltra/GeoDynamX"}],"otherCitationDetails":["python 3.12.13","numpy 2.4.3"],"title":"GeoDynamix"}},"source":["r6"]},{"description":"Fork: the window written as a derived dataset.","id":"p8","output":[{"id":"o1","sourceCitation":{"sha256":"2b20680612ddf13af68cf4971796e47f8d0de2692a63c5aff59ab9bfbdd31309","title":"boem_roi.npz"}}],"processingInformation":{"identifier":{"code":"fork","codeSpace":"geodynamix"},"runTimeParameters":{"bands":["depth_ft"]},"softwareReference":"gdx"},"source":["d1"],"stepDateTime":"2026-10-02T09:14:30Z"}],"source":[{"description":"Declared start: BOEM's library of time-migrated 3D seismic surveys (confidential).","id":"s1","sourceCitation":{"identifier":[{"code":"10.1029/2017EO073557","codeSpace":"doi"}],"title":"Kramer and Shedd 2017, Eos"}}],"statement":"A window of the BOEM northern Gulf deepwater bathymetry grid (west), forked to a derived dataset. Steps p1-p6 are BOEM's processing as reported on the product page and in Kramer and Shedd 2017; they carry no code."}