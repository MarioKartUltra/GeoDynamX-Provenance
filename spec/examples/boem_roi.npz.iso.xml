<mrl:LI_Lineage xmlns:mrl="http://standards.iso.org/iso/19115/-3/mrl/2.0"
    xmlns:mcc="http://standards.iso.org/iso/19115/-3/mcc/1.0" xmlns:cit="http://standards.iso.org/iso/19115/-3/cit/2.0"
    xmlns:gco="http://standards.iso.org/iso/19115/-3/gco/1.0" xmlns:gml="http://www.opengis.net/gml/3.2"
    xmlns:xlink="http://www.w3.org/1999/xlink">
  <mrl:statement><gco:CharacterString>A window of the BOEM northern Gulf deepwater bathymetry grid (west), forked to a derived dataset. Steps p1-p6 are BOEM's processing as reported on the product page and in Kramer and Shedd 2017; they carry no code.</gco:CharacterString></mrl:statement>
  <mrl:additionalDocumentation>
    <cit:CI_Citation>
      <cit:title><gco:CharacterString>boem_roi.npz.gprv.jsonl</gco:CharacterString></cit:title>
      <cit:identifier><mcc:MD_Identifier><mcc:code><gco:CharacterString>d35afb0211740c7e49a294f9597fe2354079175530500fff67715d26078509bc</gco:CharacterString></mcc:code><mcc:codeSpace><gco:CharacterString>sha256</gco:CharacterString></mcc:codeSpace></mcc:MD_Identifier></cit:identifier>
    </cit:CI_Citation>
  </mrl:additionalDocumentation>
  <mrl:source><mrl:LI_Source id="r703ec3d3b576.s1">
    <mrl:description><gco:CharacterString>Declared start: BOEM's library of time-migrated 3D seismic surveys (confidential).</gco:CharacterString></mrl:description>
    <mrl:sourceCitation>
      <cit:CI_Citation>
        <cit:title><gco:CharacterString>Kramer and Shedd 2017, Eos</gco:CharacterString></cit:title>
        <cit:identifier><mcc:MD_Identifier><mcc:code><gco:CharacterString>10.1029/2017EO073557</gco:CharacterString></mcc:code><mcc:codeSpace><gco:CharacterString>doi</gco:CharacterString></mcc:codeSpace></mcc:MD_Identifier></cit:identifier>
      </cit:CI_Citation>
    </mrl:sourceCitation>
  </mrl:LI_Source></mrl:source>
  <mrl:processStep><mrl:LE_ProcessStep id="r703ec3d3b576.p1">
    <mrl:description><gco:CharacterString>Reported: seafloor horizon picked on 200+ surveys; where surveys overlap, the best resolution kept, leaving 117. Confidential data.</gco:CharacterString></mrl:description>
    <mrl:source xlink:href="#r703ec3d3b576.s1"/>
    <mrl:output><mrl:LE_Source id="r703ec3d3b576.r1"/></mrl:output>
  </mrl:LE_ProcessStep></mrl:processStep>
  <mrl:processStep><mrl:LE_ProcessStep id="r703ec3d3b576.p2">
    <mrl:description><gco:CharacterString>Reported: resampled to 40 x 40 ft cells, north-south, NAD27; small gaps filled by convergent gridding.</gco:CharacterString></mrl:description>
    <mrl:source xlink:href="#r703ec3d3b576.r1"/>
    <mrl:output><mrl:LE_Source id="r703ec3d3b576.r2"/></mrl:output>
  </mrl:LE_ProcessStep></mrl:processStep>
  <mrl:processStep><mrl:LE_ProcessStep id="r703ec3d3b576.p3">
    <mrl:description><gco:CharacterString>Reported: seams shifted by hand, +/-10-20 ms two-way time (seasonal Loop Current velocities). Manual.</gco:CharacterString></mrl:description>
    <mrl:source xlink:href="#r703ec3d3b576.r2"/>
    <mrl:output><mrl:LE_Source id="r703ec3d3b576.r3"/></mrl:output>
  </mrl:LE_ProcessStep></mrl:processStep>
  <mrl:processStep><mrl:LE_ProcessStep id="r703ec3d3b576.p4">
    <mrl:description><gco:CharacterString>Reported: two-way time in ms x 0.0005 to one-way seconds, then the 7th-order time-to-depth polynomial; depth in ft.</gco:CharacterString></mrl:description>
    <mrl:reference>
      <cit:CI_Citation>
        <cit:title><gco:CharacterString>Advocate and Hood 1993, Geo-Marine Letters 13, 207-211</gco:CharacterString></cit:title>
      </cit:CI_Citation>
    </mrl:reference>
    <mrl:source xlink:href="#r703ec3d3b576.r3"/>
    <mrl:output><mrl:LE_Source id="r703ec3d3b576.r4"/></mrl:output>
  </mrl:LE_ProcessStep></mrl:processStep>
  <mrl:processStep><mrl:LE_ProcessStep id="r703ec3d3b576.p5">
    <mrl:description><gco:CharacterString>Reported: remaining gaps spliced in from 3D depth surveys.</gco:CharacterString></mrl:description>
    <mrl:source xlink:href="#r703ec3d3b576.r4"/>
    <mrl:report><mrl:LE_ProcessStepReport>
      <mrl:name><gco:CharacterString>outcome</gco:CharacterString></mrl:name>
      <mrl:description><gco:CharacterString>Checked against 300 wells: mean error 1.3 % of water depth (product page).</gco:CharacterString></mrl:description>
    </mrl:LE_ProcessStepReport></mrl:report>
    <mrl:output><mrl:LE_Source id="r703ec3d3b576.r5"/></mrl:output>
  </mrl:LE_ProcessStep></mrl:processStep>
  <mrl:processStep><mrl:LE_ProcessStep id="r703ec3d3b576.p6">
    <mrl:description><gco:CharacterString>Reported: exported from ArcMap as GeoTIFF; downloaded from the BOEM product page.</gco:CharacterString></mrl:description>
    <mrl:source xlink:href="#r703ec3d3b576.r5"/>
    <mrl:output><mrl:LE_Source id="r703ec3d3b576.r6"><mrl:sourceCitation>
      <cit:CI_Citation>
        <cit:title><gco:CharacterString>BOEMbathyW_ft.tif</gco:CharacterString></cit:title>
        <cit:identifier><mcc:MD_Identifier><mcc:code><gco:CharacterString>3e7450dea4f9329b0725aef7c25cddbac0906e0a2ad70351630ddb82a3b28b79</gco:CharacterString></mcc:code><mcc:codeSpace><gco:CharacterString>sha256</gco:CharacterString></mcc:codeSpace></mcc:MD_Identifier></cit:identifier>
      </cit:CI_Citation>
    </mrl:sourceCitation></mrl:LE_Source></mrl:output>
  </mrl:LE_ProcessStep></mrl:processStep>
  <mrl:processStep><mrl:LE_ProcessStep id="r703ec3d3b576.p7">
    <mrl:description><gco:CharacterString>ROI window, 4096x4096 from (20000, 12000).</gco:CharacterString></mrl:description>
    <mrl:source xlink:href="#r703ec3d3b576.r6"/>
    <mrl:processingInformation><mrl:LE_Processing>
      <mrl:identifier><mcc:MD_Identifier><mcc:code><gco:CharacterString>roi/window</gco:CharacterString></mcc:code><mcc:codeSpace><gco:CharacterString>geodynamix</gco:CharacterString></mcc:codeSpace></mcc:MD_Identifier></mrl:identifier>
      <mrl:softwareReference>
        <cit:CI_Citation id="r703ec3d3b576.gdx">
          <cit:title><gco:CharacterString>GeoDynamix</gco:CharacterString></cit:title>
          <cit:edition><gco:CharacterString>6194b86e5859cf5a4a0d68f8425b8ac8d86d2df8</gco:CharacterString></cit:edition>
          <cit:otherCitationDetails><gco:CharacterString>python 3.12.13</gco:CharacterString></cit:otherCitationDetails>
          <cit:otherCitationDetails><gco:CharacterString>numpy 2.4.3</gco:CharacterString></cit:otherCitationDetails>
          <cit:onlineResource><cit:CI_OnlineResource><cit:linkage><gco:CharacterString>https://github.com/MarioKartUltra/GeoDynamX</gco:CharacterString></cit:linkage></cit:CI_OnlineResource></cit:onlineResource>
        </cit:CI_Citation>
      </mrl:softwareReference>
      <mrl:runTimeParameters><gco:CharacterString>{"height":4096,"width":4096,"x0":20000,"y0":12000}</gco:CharacterString></mrl:runTimeParameters>
    </mrl:LE_Processing></mrl:processingInformation>
    <mrl:output><mrl:LE_Source id="r703ec3d3b576.d1"/></mrl:output>
  </mrl:LE_ProcessStep></mrl:processStep>
  <mrl:processStep><mrl:LE_ProcessStep id="r703ec3d3b576.p8">
    <mrl:description><gco:CharacterString>Fork: the window written as a derived dataset.</gco:CharacterString></mrl:description>
    <mrl:stepDateTime><gml:TimeInstant gml:id="r703ec3d3b576.p8.t"><gml:timePosition>2026-10-02T09:14:30Z</gml:timePosition></gml:TimeInstant></mrl:stepDateTime>
    <mrl:source xlink:href="#r703ec3d3b576.d1"/>
    <mrl:processingInformation><mrl:LE_Processing>
      <mrl:identifier><mcc:MD_Identifier><mcc:code><gco:CharacterString>fork</gco:CharacterString></mcc:code><mcc:codeSpace><gco:CharacterString>geodynamix</gco:CharacterString></mcc:codeSpace></mcc:MD_Identifier></mrl:identifier>
      <mrl:softwareReference xlink:href="#r703ec3d3b576.gdx"/>
      <mrl:runTimeParameters><gco:CharacterString>{"bands":["depth_ft"]}</gco:CharacterString></mrl:runTimeParameters>
    </mrl:LE_Processing></mrl:processingInformation>
    <mrl:output><mrl:LE_Source id="r703ec3d3b576.o1"><mrl:sourceCitation>
      <cit:CI_Citation>
        <cit:title><gco:CharacterString>boem_roi.npz</gco:CharacterString></cit:title>
        <cit:identifier><mcc:MD_Identifier><mcc:code><gco:CharacterString>2b20680612ddf13af68cf4971796e47f8d0de2692a63c5aff59ab9bfbdd31309</gco:CharacterString></mcc:code><mcc:codeSpace><gco:CharacterString>sha256</gco:CharacterString></mcc:codeSpace></mcc:MD_Identifier></cit:identifier>
      </cit:CI_Citation>
    </mrl:sourceCitation></mrl:LE_Source></mrl:output>
  </mrl:LE_ProcessStep></mrl:processStep>
</mrl:LI_Lineage>
